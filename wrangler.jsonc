{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mystrengthstraining",
  "compatibility_date": "2026-10-23",
  // The Vite build (npm run build) is served as static assets; unknown paths fall back to index.html for React Router.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // One deployment serves the main site and every organization subdomain (kumc.mystrengthstraining.com, ...).
  "routes": [
    { "pattern": "mystrengthstraining.com/*", "zone_name": "mystrengthstraining.com" },
    { "pattern": "*.mystrengthstraining.com/*", "zone_name": "mystrengthstraining.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
