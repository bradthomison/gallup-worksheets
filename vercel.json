{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://kumc.mystrengthstraining.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://kumc.mystrengthstraining.com/:path*",
      "permanent": false
    }
  ]
}
